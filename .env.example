# ==============================================================================
# ALRI-CORE - Environment Configuration Example
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# PostgreSQL Connection String
# Format: host=<ip> dbname=<name> user=<user> password=<pass> port=<port>
DATABASE_URL="host=localhost dbname=alri user=postgres password=postgres port=5432"

# Server Operation Mode (HTTP / HTTPS)
# Note: HTTPS requires valid certificates in the certificates/ directory.
OPERATION_MODE=HTTPS

# Network Ports
SERVER_PORT=443
HTTP_REDIRECT_PORT=80

# Debug & Telemetry
# Set to true to print all audit logs directly to the TTY terminal
TTY_PRINT_ENABLED=false
